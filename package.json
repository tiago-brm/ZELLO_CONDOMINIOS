{
  "name": "app-root",
  "version": "0.0.0",
  "private": true,
  "description": "{{PROJETO}} - SaaS multi-tenant",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "test:full": "pnpm -r test:full",
    "check-env": "node scripts/check-env.mjs",
    "init": "node scripts/init-project.mjs",
    "test:db": "node scripts/test-db.mjs check",
    "test:local": "node scripts/test-db.mjs run -- pnpm test:full"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  }
}
